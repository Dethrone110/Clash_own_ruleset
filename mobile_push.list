# Android mobile push and Xiaohongshu rules: route DIRECT before AI-US / pipi.
# Keeps domestic app push long connections away from proxy groups and fake routing surprises.

# Xiaohongshu / XHS
DOMAIN-SUFFIX,xiaohongshu.com
DOMAIN-SUFFIX,xhscdn.com
DOMAIN-SUFFIX,xhslink.com
DOMAIN-KEYWORD,xiaohongshu
DOMAIN-KEYWORD,xhscdn

# Generic Android / Google push path
DOMAIN,mtalk.google.com
DOMAIN-SUFFIX,mtalk.google.com
DOMAIN-SUFFIX,android.googleapis.com
DOMAIN-SUFFIX,firebaseinstallations.googleapis.com
DOMAIN-SUFFIX,firebaseio.com
DOMAIN-SUFFIX,firebaseapp.com
DOMAIN-SUFFIX,firebaseappcheck.googleapis.com
DOMAIN-SUFFIX,fcm.googleapis.com

# Getui / igexin
DOMAIN-SUFFIX,getui.com
DOMAIN-SUFFIX,igexin.com
DOMAIN-SUFFIX,igetui.com
DOMAIN-SUFFIX,gepush.com
