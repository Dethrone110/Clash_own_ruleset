name: Clash own ruleset
desc: Country-sticky AI, account, Web3, and Hong Kong finance routing
mode: rule

profile:
  store-selected: true

# Replace airport groups while preserving its proxies unchanged.
proxy-groups: #!replace
  - name: 🚀 Proxy
    type: select
    proxies:
      - 🌏 Near Auto
      - 🇹🇼 TW Stable Auto
      - 🇯🇵 JP Stable Auto
      - 🇸🇬 SG Stable Auto
      - 🇭🇰 HK Stable Auto
      - DIRECT
      - REJECT

  - name: 🇺🇸 AI-US
    type: select
    proxies:
      - 🇺🇸 US Account Auto
      - 🇺🇸 US Stable Auto
      - 🇺🇸 US Account Nodes
      - 🇺🇸 US Stable Nodes
      - 🇺🇸 US Telecom Nodes
      - REJECT

  - name: pipi-a
    type: select
    proxies:
      - 🇹🇼 TW Stable Auto
      - 🇯🇵 JP Stable Auto
      - REJECT

  - name: pipi-b
    type: select
    proxies:
      - 🌐 pipi-b Auto
      - 🇹🇼 TW Stable Auto
      - 🇯🇵 JP Stable Auto
      - 🇸🇬 SG Stable Auto
      - REJECT

  - name: ganggang
    type: select
    proxies:
      - 🇭🇰 HK Stable Auto
      - 🇭🇰 HK Stable Nodes
      - 🇭🇰 HK Dynamic Nodes
      - REJECT

  - name: 📢 Social
    type: select
    proxies:
      - 🌏 Near Auto
      - 🇯🇵 JP Stable Auto
      - 🇹🇼 TW Stable Auto
      - 🇸🇬 SG Stable Auto
      - 🇭🇰 HK Stable Auto
      - 🇺🇸 US Account Auto
      - 🚀 Proxy
      - DIRECT
      - REJECT

  - name: ✖️ X
    type: select
    proxies:
      - 🌏 Near Auto
      - 🇯🇵 JP Stable Auto
      - 🇹🇼 TW Stable Auto
      - 🇸🇬 SG Stable Auto
      - 🇭🇰 HK Stable Auto
      - 🇺🇸 US Account Auto
      - 🚀 Proxy
      - DIRECT
      - REJECT

  - name: Ⓜ️ Microsoft
    type: select
    proxies:
      - 🌏 Near Auto
      - 🇯🇵 JP Stable Auto
      - 🇹🇼 TW Stable Auto
      - 🇸🇬 SG Stable Auto
      - 🇭🇰 HK Stable Auto
      - 🇺🇸 US Account Auto
      - DIRECT
      - 🚀 Proxy
      - REJECT

  - name: 🍎 Apple
    type: select
    proxies:
      - DIRECT
      - 🌏 Near Auto
      - 🚀 Proxy
      - REJECT

  - name: 🎯 Direct
    type: select
    proxies:
      - DIRECT
      - 🚀 Proxy

  - name: 🔒 Direct-Extra
    type: select
    proxies:
      - DIRECT

  - name: 🛑 Block
    type: select
    proxies:
      - REJECT
      - DIRECT

  - name: 🍃 Clean
    type: select
    proxies:
      - REJECT
      - DIRECT

  - name: 🐟 Final
    type: select
    proxies:
      - 🚀 Proxy
      - 🎯 Direct
      - REJECT

  - name: 🇹🇼 TW Stable Auto
    type: url-test
    url: https://www.gstatic.com/generate_204
    interval: 600
    tolerance: 120
    proxies: [REJECT]
    include-all: true
    filter: '(?i)^(\[(vless|hy2|hysteria2)\]\s*)?TW\s+Extreme\s+[0-9]+$'

  - name: 🇹🇼 TW Stable Nodes
    type: select
    proxies: [REJECT]
    include-all: true
    filter: '(?i)^(\[(vless|hy2|hysteria2)\]\s*)?TW\s+Extreme\s+[0-9]+$'

  - name: 🇯🇵 JP Stable Auto
    type: url-test
    url: https://www.gstatic.com/generate_204
    interval: 600
    tolerance: 120
    proxies: [REJECT]
    include-all: true
    filter: '(?i)^(\[(vless|hy2|hysteria2)\]\s*)?JP\s+(Extreme|Prestige\s+三网直连)\s+[0-9]+$'

  - name: 🇯🇵 JP Stable Nodes
    type: select
    proxies: [REJECT]
    include-all: true
    filter: '(?i)^(\[(vless|hy2|hysteria2)\]\s*)?JP\s+(Extreme|Prestige\s+三网直连)\s+[0-9]+$'

  - name: 🇸🇬 SG Stable Auto
    type: url-test
    url: https://www.gstatic.com/generate_204
    interval: 600
    tolerance: 150
    proxies: [REJECT]
    include-all: true
    filter: '(?i)^(\[(vless|hy2|hysteria2)\]\s*)?SG\s+(Extreme|Ultimate|Max)\s+[0-9]+$'

  - name: 🇸🇬 SG Stable Nodes
    type: select
    proxies: [REJECT]
    include-all: true
    filter: '(?i)^(\[(vless|hy2|hysteria2)\]\s*)?SG\s+(Extreme|Ultimate|Max)\s+[0-9]+$'

  - name: 🇭🇰 HK Stable Auto
    type: url-test
    url: https://www.gstatic.com/generate_204
    interval: 600
    tolerance: 120
    proxies: [REJECT]
    include-all: true
    filter: '(?i)^(\[(vless|hy2|hysteria2)\]\s*)?HK\s+Extreme\s+[0-9]+$'

  - name: 🇭🇰 HK Stable Nodes
    type: select
    proxies: [REJECT]
    include-all: true
    filter: '(?i)^(\[(vless|hy2|hysteria2)\]\s*)?HK\s+Extreme\s+[0-9]+$'

  - name: 🇭🇰 HK Dynamic Nodes
    type: select
    proxies: [REJECT]
    include-all: true
    filter: '(?i)^(\[(vless|hy2|hysteria2)\]\s*)?HK\s+Dynamic\s+[0-9]+(\s+电信优化)?$'

  - name: 🇺🇸 US Account Auto
    type: url-test
    url: https://www.gstatic.com/generate_204
    interval: 900
    tolerance: 180
    proxies: [REJECT]
    include-all: true
    filter: '(?i)^(\[(vless|hy2|hysteria2)\]\s*)?US\s+(Extreme(\s+HY2)?|Prestige\s+三网直连)\s+[0-9]+$'

  - name: 🇺🇸 US Account Nodes
    type: select
    proxies: [REJECT]
    include-all: true
    filter: '(?i)^(\[(vless|hy2|hysteria2)\]\s*)?US\s+(Extreme(\s+HY2)?|Prestige\s+三网直连)\s+[0-9]+$'

  - name: 🇺🇸 US Stable Auto
    type: url-test
    url: https://www.gstatic.com/generate_204
    interval: 1200
    tolerance: 220
    proxies: [REJECT]
    include-all: true
    filter: '(?i)^(\[(vless|hy2|hysteria2)\]\s*)?US\s+(Ultimate|Ultiamte|Max)\s+[0-9]+$'

  - name: 🇺🇸 US Stable Nodes
    type: select
    proxies: [REJECT]
    include-all: true
    filter: '(?i)^(\[(vless|hy2|hysteria2)\]\s*)?US\s+(Ultimate|Ultiamte|Max)\s+[0-9]+$'

  - name: 🇺🇸 US Telecom Nodes
    type: select
    proxies: [REJECT]
    include-all: true
    filter: '(?i)^(\[(vless|hy2|hysteria2)\]\s*)?US\s+(Prestige|Ultimate|Ultiamte)\s+电信专用\s+[0-9]+$'

  - name: 🌏 Near Auto
    type: url-test
    url: https://www.gstatic.com/generate_204
    interval: 600
    tolerance: 150
    proxies: [REJECT]
    include-all: true
    filter: '(?i)^(\[(vless|hy2|hysteria2)\]\s*)?(TW\s+Extreme|JP\s+(Extreme|Prestige\s+三网直连)|SG\s+(Extreme|Ultimate|Max)|HK\s+Extreme)\s+[0-9]+$'

  - name: 🌐 pipi-b Auto
    type: url-test
    url: https://www.gstatic.com/generate_204
    interval: 600
    tolerance: 150
    proxies: [REJECT]
    include-all: true
    filter: '(?i)^(\[(vless|hy2|hysteria2)\]\s*)?(TW\s+Extreme|JP\s+(Extreme|Prestige\s+三网直连)|SG\s+(Extreme|Ultimate|Max))\s+[0-9]+$'

  - name: IPv6 Lab
    type: select
    proxies: [REJECT]
    include-all: true
    filter: '(?i)^(\[(vless|hy2|hysteria2)\]\s*)?(US|TW|JP|SG|AU)\s+.*IPv6.*$'

  - name: Dynamic Lab
    type: select
    proxies: [REJECT]
    include-all: true
    filter: '(?i)^(\[(vless|hy2|hysteria2)\]\s*)?(TW|HK)\s+Dynamic(\s|$)'

