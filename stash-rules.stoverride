name: Clash own ruleset
desc: Region-based AI, Web3, Hong Kong finance, and general routing
mode: rule

profile:
  store-selected: true

# Replace airport groups while preserving its proxies unchanged.
proxy-groups: #!replace
  # Service groups select regions. AI backups are manual to prevent silent country changes.
  - name: 🚀 Proxy
    type: select
    proxies:
      - 🌍 All Auto
      - 🇹🇼 TW Auto
      - 🇯🇵 JP Auto
      - 🇸🇬 SG Auto
      - 🇭🇰 HK Auto
      - 🇺🇸 US Auto
      - 🇬🇧 UK Auto
      - 🇩🇪 DE Auto
      - 🇦🇺 AU Auto
      - 🌐 All Nodes
      - 🇹🇼 TW Nodes
      - 🇯🇵 JP Nodes
      - 🇸🇬 SG Nodes
      - 🇭🇰 HK Nodes
      - 🇺🇸 US Nodes
      - 🇬🇧 UK Nodes
      - 🇩🇪 DE Nodes
      - 🇦🇺 AU Nodes
      - DIRECT
      - REJECT

  - name: 🇺🇸 AI-US
    type: select
    proxies:
      - 🇺🇸 US Auto
      - 🇺🇸 US Nodes
      - 🇯🇵 JP Auto
      - 🇯🇵 JP Nodes
      - 🇸🇬 SG Auto
      - 🇸🇬 SG Nodes
      - 🇬🇧 UK Auto
      - 🇬🇧 UK Nodes
      - 🇹🇼 TW Auto
      - 🇹🇼 TW Nodes
      - 🇩🇪 DE Auto
      - 🇩🇪 DE Nodes
      - 🇦🇺 AU Auto
      - 🇦🇺 AU Nodes
      - REJECT

  - name: pipi-a
    type: select
    proxies:
      - 🇹🇼 TW Auto
      - 🇹🇼 TW Nodes
      - 🇯🇵 JP Auto
      - 🇯🇵 JP Nodes
      - REJECT

  - name: pipi-b
    type: select
    proxies:
      - 🇯🇵 JP Auto
      - 🇯🇵 JP Nodes
      - 🇹🇼 TW Auto
      - 🇹🇼 TW Nodes
      - 🇸🇬 SG Auto
      - 🇸🇬 SG Nodes
      - 🇭🇰 HK Auto
      - 🇭🇰 HK Nodes
      - 🇬🇧 UK Auto
      - 🇬🇧 UK Nodes
      - 🇩🇪 DE Auto
      - 🇩🇪 DE Nodes
      - 🇦🇺 AU Auto
      - 🇦🇺 AU Nodes
      - REJECT

  - name: ganggang
    type: select
    proxies:
      - 🇭🇰 HK Auto
      - 🇭🇰 HK Nodes
      - REJECT

  - name: 📢 Social
    type: select
    proxies:
      - 🌍 All Auto
      - 🌐 All Nodes
      - 🇯🇵 JP Auto
      - 🇯🇵 JP Nodes
      - 🇹🇼 TW Auto
      - 🇹🇼 TW Nodes
      - 🇸🇬 SG Auto
      - 🇸🇬 SG Nodes
      - 🇭🇰 HK Auto
      - 🇭🇰 HK Nodes
      - 🇺🇸 US Auto
      - 🇺🇸 US Nodes
      - 🇬🇧 UK Auto
      - 🇬🇧 UK Nodes
      - 🇩🇪 DE Auto
      - 🇩🇪 DE Nodes
      - 🇦🇺 AU Auto
      - 🇦🇺 AU Nodes
      - DIRECT
      - REJECT

  - name: ✖️ X
    type: select
    proxies:
      - 🌍 All Auto
      - 🌐 All Nodes
      - 🇯🇵 JP Auto
      - 🇯🇵 JP Nodes
      - 🇹🇼 TW Auto
      - 🇹🇼 TW Nodes
      - 🇸🇬 SG Auto
      - 🇸🇬 SG Nodes
      - 🇭🇰 HK Auto
      - 🇭🇰 HK Nodes
      - 🇺🇸 US Auto
      - 🇺🇸 US Nodes
      - 🇬🇧 UK Auto
      - 🇬🇧 UK Nodes
      - 🇩🇪 DE Auto
      - 🇩🇪 DE Nodes
      - 🇦🇺 AU Auto
      - 🇦🇺 AU Nodes
      - DIRECT
      - REJECT

  - name: Ⓜ️ Microsoft
    type: select
    proxies:
      - 🌍 All Auto
      - 🌐 All Nodes
      - 🇯🇵 JP Auto
      - 🇯🇵 JP Nodes
      - 🇹🇼 TW Auto
      - 🇹🇼 TW Nodes
      - 🇸🇬 SG Auto
      - 🇸🇬 SG Nodes
      - 🇭🇰 HK Auto
      - 🇭🇰 HK Nodes
      - 🇺🇸 US Auto
      - 🇺🇸 US Nodes
      - 🇬🇧 UK Auto
      - 🇬🇧 UK Nodes
      - 🇩🇪 DE Auto
      - 🇩🇪 DE Nodes
      - 🇦🇺 AU Auto
      - 🇦🇺 AU Nodes
      - DIRECT
      - REJECT

  - name: 🍎 Apple
    type: select
    proxies:
      - DIRECT
      - 🌍 All Auto
      - 🌐 All Nodes
      - 🇯🇵 JP Auto
      - 🇯🇵 JP Nodes
      - 🇹🇼 TW Auto
      - 🇹🇼 TW Nodes
      - 🇸🇬 SG Auto
      - 🇸🇬 SG Nodes
      - 🇭🇰 HK Auto
      - 🇭🇰 HK Nodes
      - 🇺🇸 US Auto
      - 🇺🇸 US Nodes
      - 🇬🇧 UK Auto
      - 🇬🇧 UK Nodes
      - 🇩🇪 DE Auto
      - 🇩🇪 DE Nodes
      - 🇦🇺 AU Auto
      - 🇦🇺 AU Nodes
      - REJECT

  - name: 🎯 Direct
    type: select
    proxies:
      - DIRECT
      - 🚀 Proxy

  - name: 🔒 Direct-Extra
    type: select
    proxies:
      - DIRECT

  - name: 🛑 Block
    type: select
    proxies:
      - REJECT
      - DIRECT

  - name: 🍃 Clean
    type: select
    proxies:
      - REJECT
      - DIRECT

  - name: 🐟 Final
    type: select
    proxies:
      - 🚀 Proxy
      - 🎯 Direct
      - REJECT

  # Airport-specific aliases plus known plan families keep notices out of node groups.
  - name: 🌍 All Auto
    type: url-test
    url: https://www.gstatic.com/generate_204
    interval: 600
    tolerance: 180
    proxies: [REJECT]
    include-all: true
    filter: '(?i)^(\[(vless|hy2|hysteria|hysteria2)\]\s*)?(US|TW|JP|SG|HK|UK|DE|AU)(\s|$)'

  - name: 🌐 All Nodes
    type: select
    proxies: [REJECT]
    include-all: true
    filter: '(?i)^(\[(vless|hy2|hysteria|hysteria2)\]\s*)?(US|TW|JP|SG|HK|UK|DE|AU)(\s|$)'

  - name: 🇺🇸 US Auto
    type: url-test
    url: https://www.gstatic.com/generate_204
    interval: 600
    tolerance: 180
    proxies: [REJECT]
    include-all: true
    filter: '(?i)^(\[(vless|hy2|hysteria|hysteria2)\]\s*)?US(\s|$)'

  - name: 🇺🇸 US Nodes
    type: select
    proxies: [REJECT]
    include-all: true
    filter: '(?i)^(\[(vless|hy2|hysteria|hysteria2)\]\s*)?US(\s|$)'

  - name: 🇹🇼 TW Auto
    type: url-test
    url: https://www.gstatic.com/generate_204
    interval: 600
    tolerance: 150
    proxies: [REJECT]
    include-all: true
    filter: '(?i)^(\[(vless|hy2|hysteria|hysteria2)\]\s*)?TW(\s|$)'

  - name: 🇹🇼 TW Nodes
    type: select
    proxies: [REJECT]
    include-all: true
    filter: '(?i)^(\[(vless|hy2|hysteria|hysteria2)\]\s*)?TW(\s|$)'

  - name: 🇯🇵 JP Auto
    type: url-test
    url: https://www.gstatic.com/generate_204
    interval: 600
    tolerance: 150
    proxies: [REJECT]
    include-all: true
    filter: '(?i)^(\[(vless|hy2|hysteria|hysteria2)\]\s*)?JP(\s|$)'

  - name: 🇯🇵 JP Nodes
    type: select
    proxies: [REJECT]
    include-all: true
    filter: '(?i)^(\[(vless|hy2|hysteria|hysteria2)\]\s*)?JP(\s|$)'

  - name: 🇸🇬 SG Auto
    type: url-test
    url: https://www.gstatic.com/generate_204
    interval: 600
    tolerance: 150
    proxies: [REJECT]
    include-all: true
    filter: '(?i)^(\[(vless|hy2|hysteria|hysteria2)\]\s*)?SG(\s|$)'

  - name: 🇸🇬 SG Nodes
    type: select
    proxies: [REJECT]
    include-all: true
    filter: '(?i)^(\[(vless|hy2|hysteria|hysteria2)\]\s*)?SG(\s|$)'

  - name: 🇭🇰 HK Auto
    type: url-test
    url: https://www.gstatic.com/generate_204
    interval: 600
    tolerance: 150
    proxies: [REJECT]
    include-all: true
    filter: '(?i)^(\[(vless|hy2|hysteria|hysteria2)\]\s*)?HK(\s|$)'

  - name: 🇭🇰 HK Nodes
    type: select
    proxies: [REJECT]
    include-all: true
    filter: '(?i)^(\[(vless|hy2|hysteria|hysteria2)\]\s*)?HK(\s|$)'

  - name: 🇬🇧 UK Auto
    type: url-test
    url: https://www.gstatic.com/generate_204
    interval: 600
    tolerance: 180
    proxies: [REJECT]
    include-all: true
    filter: '(?i)^(\[(vless|hy2|hysteria|hysteria2)\]\s*)?UK(\s|$)'

  - name: 🇬🇧 UK Nodes
