name: Clash own ruleset
desc: Service routing with shared regional selectors
mode: rule
profile:
  store-selected: true
proxy-groups: #!replace
- name: 🚀 Proxy
  type: select
  proxies:
  - 🇯🇵 JP Auto
  - 🌍 All Auto
  - 🇯🇵 JP Nodes
  - 🇹🇼 TW Auto
  - 🇹🇼 TW Nodes
