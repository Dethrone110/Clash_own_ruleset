    filter: '(?i)^(\[(vless|hy2|hysteria|hysteria2)\]\s*)?UK(\s|$)'

  - name: 🇩🇪 DE Auto
    type: url-test
    url: https://www.gstatic.com/generate_204
    interval: 600
    tolerance: 200
    proxies: [REJECT]
    include-all: true
    filter: '(?i)^(\[(vless|hy2|hysteria|hysteria2)\]\s*)?DE(\s|$)'

  - name: 🇩🇪 DE Nodes
