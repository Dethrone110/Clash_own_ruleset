rules: #!replace
  - RULE-SET,LocalAreaNetwork,🎯 Direct
  - RULE-SET,MobilePush,🎯 Direct
  - RULE-SET,ChinaAI,🎯 Direct
  - DOMAIN-SUFFIX,bankofchina.com,🎯 Direct
  - DOMAIN-SUFFIX,unionpay.com,🎯 Direct
  - RULE-SET,AI,🇺🇸 AI-US
  - RULE-SET,US,🇺🇸 AI-US
  - RULE-SET,OpenAI,🇺🇸 AI-US
  - RULE-SET,Gemini,🇺🇸 AI-US
  - RULE-SET,PipiAccount,pipi-a
  - RULE-SET,ganggangLocal,ganggang
  - RULE-SET,pipiLocal,pipi-b
  - RULE-SET,Crypto,pipi-b
  - RULE-SET,Web3,pipi-b
  - RULE-SET,BanAD,🛑 Block
  - RULE-SET,Hijacking,🛑 Block
  - RULE-SET,BanProgramAD,🍃 Clean
  - RULE-SET,Twitter,✖️ X
  - RULE-SET,Telegram,📢 Social
  - RULE-SET,Discord,📢 Social
  - RULE-SET,Reddit,📢 Social
  - RULE-SET,Slack,📢 Social
  - RULE-SET,WhatsApp,📢 Social
  - RULE-SET,Signal,📢 Social
  - RULE-SET,Instagram,📢 Social
  - RULE-SET,Facebook,📢 Social
  - RULE-SET,Microsoft,Ⓜ️ Microsoft
  - RULE-SET,Apple,🍎 Apple
  - RULE-SET,ProxyLite,🚀 Proxy
  - RULE-SET,OwnDirect,🔒 Direct-Extra
  - RULE-SET,SteamCN,🎯 Direct
  - RULE-SET,GoogleCN,🎯 Direct
  - RULE-SET,ChinaDomain,🎯 Direct
  - RULE-SET,ChinaCompanyIp,🎯 Direct
  - RULE-SET,Download,🎯 Direct
  - GEOSITE,CN,🎯 Direct
  - GEOSITE,geolocation-!cn,🚀 Proxy
  - GEOIP,CN,🎯 Direct,no-resolve
  - MATCH,🐟 Final
